# Application Configuration
APP_NAME="AI Room Image Analysis & Product Search"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security Settings
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "webp"]

# Database Configuration (PostgreSQL + pgvector)
# Example local postgres connection:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/room_search_db
# Set to True to enable fallback in-memory/sqlite mode for isolated local unit tests when PostgreSQL is unavailable
USE_DB_MOCK_FALLBACK=False

# Model Configuration
MODEL_NAME=resnet18
EMBEDDING_DIM=512
TOP_K_DEFAULT=3
